parameters:
	level: max
	paths:
		- src
		- tests
	excludePaths:
		- tests/tmp/*
	fileExtensions:
		- php
		- phpt
	ignoreErrors:
		-
			message: "#^Call to function method_exists\\(\\) with Contributte\\\\Middlewares\\\\Application\\\\IApplication and 'runWith' will always evaluate to true\\.$#"
			count: 1
			path: src/ControllerTester.php

		-
			message: "#^Call to an undefined static method Contributte\\\\Tester\\\\Environment\\:\\:setupVariables\\(\\)\\.$#"
			count: 1
			path: tests/bootstrap.php

		-
			message: "#^Call to function method_exists\\(\\) with 'Contributte\\\\\\\\Tester\\\\\\\\Environment' and 'setupFolders' will always evaluate to true\\.$#"
			count: 1
			path: tests/bootstrap.php
